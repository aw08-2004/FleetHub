# FleetHub hub -- bootstrap config for deploy/docker/compose.yaml.
#
#   cp example.env .env      (in deploy/docker/, beside compose.yaml)
#
# The real .env is gitignored; this template is not. Generate each secret with:
#
#   python -c "import secrets; print(secrets.token_hex(32))"

# ---------------------------------------------------------------- image
# Pin to a version (e.g. 1.143.0) to choose when a release goes in; "latest" follows main,
# "beta" follows the beta branch. Read by compose itself, not by the hub.
HUB_TAG=latest

# ---------------------------------------------------------------- required
# Signs session cookies. Changing it signs everyone out.
FLASK_SECRET_KEY=change-me
# Comma-separated break-glass admins: every capability over every machine.
ALLOWED_EMAILS=admin@example.com
# The public URL agents and browsers reach the hub on (the tunnel or proxy, not :29443).
HUB_URL=https://fleethub.example.com
# Agents present these to enroll and to report. Must match what the agents were given.
AGENT_ENROLLMENT_SECRET=change-me
AGENT_REPORT_SECRET=change-me

# The hub's own listener, behind the proxy: HTTPS on 29443 (hub 1.170.0+). The hub creates a
# self-signed certificate in the volume (/state/tls/hub.crt and hub.key) on first start; put
# your own PEM pair there instead to use it. Point the proxy at https://127.0.0.1:29443 --
# Cloudflare tunnel: No TLS Verify on; nginx: proxy_ssl_verify off (or trust hub.crt).
# Leave both lines out to keep a pre-1.170.0 deployment on plain HTTP and 3001.
FLEETHUB_PORT=29443
FLEETHUB_TLS=1

# ---------------------------------------------------------------- optional
# SESSION_LIFETIME_DAYS=7

# Outgoing mail for alerts. SMTP_SECURITY is starttls (default), ssl or none.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# Let alert webhooks target private/LAN addresses.
# NOTIFY_WEBHOOK_ALLOW_PRIVATE=0

# Push notifications for the mobile client. The service-account path is inside the
# container, so mount the JSON file under /state.
# FCM_SERVICE_ACCOUNT=/state/fcm-service-account.json
# FCM_PROJECT_ID=

# ---------------------------------------------------------------- do NOT set here
# The hub writes these to /state/.env itself (Settings pages, first-start key generation).
# A value here shadows that file -- load_dotenv never overrides a variable already set -- so
# a console change would look saved and then revert on the next recreate:
#
#   GOOGLE_CLIENT_ID  GOOGLE_CLIENT_SECRET
#   OIDC_CLIENT_ID  OIDC_CLIENT_SECRET  OIDC_ISSUER  OIDC_METADATA_URL
#   OIDC_DISPLAY_NAME  OIDC_SCOPES
#   AI_API_KEY  REMOTE_TURN_SECRET  DIRECTORY_BIND_PASSWORD  BACKUP_MASTER_KEY
#   REMOTE_ICE_SERVERS_JSON  REMOTE_CLOUDFLARE_TURN_KEY_ID  REMOTE_CLOUDFLARE_TURN_API_TOKEN
#
# And these belong to the image:
#
#   HUB_STATE_DIR  HUB_LOG_DIR  HUB_RECORDINGS_DIR  HUB_UPDATE_MODE
